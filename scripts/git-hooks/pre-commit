#!/usr/bin/env bash
# RGX pre-commit hook — layer E3 of the Doctrine Enforcement Architecture
# (`DOCTRINE_ENFORCEMENT.md` §7).
#
# Two phases, in order:
#   1. DERIVE — regenerate derived artifacts and stage them, so a derived file
#      is always in sync at zero agent cost (the one sanctioned mutation, per
#      the standard's §4(4) "derive-and-stage" carve-out).
#   2. ENFORCE — run THE driver (`scripts/check_doctrines.sh`), which owns the
#      doctrine registry and reports per-doctrine PASS/FAIL/SKIP. Any breach
#      blocks the commit.
#
# Adding or changing a doctrine is a change to the registry + its check script —
# NOT to this hook. That is the point: one driver, gated identically here (E3)
# and in CI (E4, via `scripts/run-local-ci.sh`).
#
# Activate once per clone:  ./scripts/setup-hooks.sh
# Last-resort bypass:       git commit --no-verify   (must be justified in the
#   commit body per COMMIT.md — never a silent default).
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# --- Phase 1: derive-and-stage -------------------------------------------------
# Knowledge Map (KNOWLEDGE_MAP_ARCHITECTURE.md §6): regenerate the derived map and
# stage it BEFORE the driver runs, so the KNOWLEDGE-MAP doctrine's derive-and-diff
# check sees a synced tree instead of failing on drift the hook could fix itself.
"$repo_root/knowledge-map/scripts/gen_knowledge_map.sh" >/dev/null
git add "$("$repo_root/knowledge-map/scripts/gen_knowledge_map.sh" --print-map-path)" 2>/dev/null || true

# --- Phase 2: enforce every registered doctrine --------------------------------
exec "$repo_root/scripts/check_doctrines.sh" --scope hook
